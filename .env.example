# ── HuggingFace (NileChat LLM) ─────────────────────────────────────────────
# Get a free key at https://huggingface.co/settings/tokens (role: Read)
HF_API_KEY=hf_your_key_here
NILECHAT_SPACE=MBZUAI-Paris/Nile-Chat-12B

# ── Database ────────────────────────────────────────────────────────────────
# Local SQLite file, created automatically on first start
DB_PATH=nilechat.db

# ── WhatsApp Business Cloud API (Meta) ─────────────────────────────────────
# Get from developers.facebook.com → Your App → WhatsApp → API Setup
WHATSAPP_TOKEN=your_whatsapp_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=nilechat_whatsapp_secret
WHATSAPP_APP_SECRET=your_app_secret

# ── Messenger (Facebook) ────────────────────────────────────────────────────
MESSENGER_PAGE_ACCESS_TOKEN=your_page_access_token
MESSENGER_VERIFY_TOKEN=nilechat_messenger_secret
MESSENGER_APP_SECRET=your_app_secret
MESSENGER_PAGE_ID=your_page_id

# ── Facebook App (for Messenger OAuth) ─────────────────────────────────────
FB_APP_ID=your_facebook_app_id

# ── ngrok (for local dev tunnel) ───────────────────────────────────────────
# Get free authtoken at https://dashboard.ngrok.com
NGROK_AUTHTOKEN=your_ngrok_token

# ── Base URL ────────────────────────────────────────────────────────────────
# Dev: your ngrok URL. Prod: your VPS domain (https://yourdomain.com)
BASE_URL=https://your-ngrok-url.ngrok-free.app

# ── WhatsApp QR microservice ────────────────────────────────────────────────
WA_SERVICE_URL=http://localhost:3001

# ── Admin Dashboard ─────────────────────────────────────────────────────────
ADMIN_API_KEY=change_this_to_something_strong

# ── Server ──────────────────────────────────────────────────────────────────
PORT=8000
